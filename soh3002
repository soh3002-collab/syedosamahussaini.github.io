        typeSpeed: CONFIG.typeSpeed,
        deleteSpeed: CONFIG.deleteSpeed,
        pause: CONFIG.pauseBetween
    });
}
/* 
    SYED OSAMA HUSSAINI — PROFESSIONAL PORTFOLIO
    STAGE 5: GLOBAL DESIGN SYSTEM (CSS)
*/

@import url('https://fonts.googleapis.com/css2?family=DM+Sans:ital,wght@0,300;0,400;0,500;0,600&family=JetBrains+Mono:wght@400;500&family=Playfair+Display:ital,wght@0,400;0,700;0,900;1,400&display=swap');

:root {
    /* Color System - Navy & Gold */
    --color-navy-900: #0A192F;
    --color-navy-800: #0D2137;
    --color-navy-700: #112240;
    --color-navy-600: #162B4A;
    --color-navy-500: #1E3A5F;
    --color-navy-400: #2A4D72;
    
    --color-gold-700: #B89420;
    --color-gold-600: #C9A230;
    --color-gold-500: #D4AF37;
    --color-gold-400: #DCC054;
    --color-gold-300: #E8D080;
    
    --color-white: #FFFFFF;
    --color-off-white: #E8EDF5;
    --color-text-primary: #C8D6E8;
    --color-text-secondary: #8AAAC8;
    --color-text-muted: #5A7A9A;

    /* Semantic Categories */
    --cat-energy: #F59E0B;
    --cat-hvac: #06B6D4;
    --cat-fea: #8B5CF6;
    --cat-cfd: #3B82F6;
    --cat-ml: #10B981;
    --cat-aerospace: #F97316;
    --cat-robotics: #EF4444;
    --cat-design: #6366F1;

    /* Typography */
    --font-display: 'Playfair Display', Georgia, serif;
    --font-body: 'DM Sans', sans-serif;
    --font-mono: 'JetBrains Mono', monospace;

    /* Spacing */
    --space-unit: 4px;
    --container-max: 1200px;
    
    /* Transitions & Shadows */
    --ease-standard: cubic-bezier(0.4, 0, 0.2, 1);
    --shadow-card: 0 10px 30px -15px rgba(2, 12, 27, 0.7);
    --shadow-gold: 0 0 20px rgba(212, 175, 55, 0.15);
    --glass-bg: rgba(17, 34, 64, 0.75);
    --glass-border: rgba(212, 175, 55, 0.15);
}

/* 1. Global Resets */
*, *::before, *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

html {
    scroll-behavior: smooth;
    font-size: 16px;
    -webkit-font-smoothing: antialiased;
}

body {
    background-color: var(--color-navy-900);
    color: var(--color-text-primary);
    font-family: var(--font-body);
    line-height: 1.75;
    overflow-x: hidden;
}

h1, h2, h3, h4 {
    font-family: var(--font-display);
    color: var(--color-white);
    line-height: 1.2;
}

a {
    text-decoration: none;
    color: inherit;
    transition: var(--ease-standard);
}

ul { list-style: none; }

img { max-width: 100%; display: block; }

/* 2. Layout & Containers */
.container {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 2rem;
}

.section {
    padding: 6rem 0;
    position: relative;
}

.section-alt {
    background-color: var(--color-navy-800);
}

/* 3. Typography & Section Headers */
.section-label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-gold-500);
    text-transform: uppercase;
    letter-spacing: 0.25em;
    display: block;
    margin-bottom: 0.5rem;
    text-align: center;
}

.section-title {
    font-size: clamp(2rem, 5vw, 3rem);
    text-align: center;
    margin-bottom: 1.5rem;
}

.gold-divider {
    width: 80px;
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--color-gold-500), transparent);
    margin: 0 auto 3rem;
}

/* 4. Glassmorphism Components */
.glass-card {
    background: var(--glass-bg);
    border: 1px solid var(--glass-border);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-radius: 12px;
    transition: all 0.35s var(--ease-standard);
    box-shadow: var(--shadow-card);
}

.glass-card:hover {
    transform: translateY(-5px);
    border-color: rgba(212, 175, 55, 0.4);
    box-shadow: 0 20px 40px -15px rgba(2, 12, 27, 0.8), var(--shadow-gold);
}

/* 5. Navigation */
.navbar {
    position: fixed;
    top: 0;
    width: 100%;
    z-index: 1000;
    padding: 1.5rem 0;
    transition: all 0.4s var(--ease-standard);
}

.navbar.scrolled {
    padding: 0.8rem 0;
    background: rgba(10, 25, 47, 0.95);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--glass-border);
}

.nav-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.logo {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 900;
    color: var(--color-white);
}

.logo span { color: var(--color-gold-500); }

.nav-links {
    display: flex;
    gap: 2rem;
    align-items: center;
}

.nav-item {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--color-text-primary);
    position: relative;
}

.nav-item::after {
    content: '';
    position: absolute;
    width: 0;
    height: 1px;
    bottom: -4px;
    left: 0;
    background-color: var(--color-gold-500);
    transition: width 0.3s ease;
}

.nav-item:hover { color: var(--color-gold-500); }
.nav-item:hover::after { width: 100%; }

/* 6. Buttons */
.btn {
    display: inline-flex;
    align-items: center;
    padding: 0.8rem 2rem;
    border-radius: 6px;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.9rem;
    cursor: pointer;
    transition: all 0.3s var(--ease-standard);
}

.btn-primary {
    background-color: var(--color-gold-500);
    color: var(--color-navy-900);
    border: none;
}

.btn-primary:hover {
    background-color: var(--color-gold-400);
    transform: translateY(-2px);
    box-shadow: 0 10px 20px rgba(212, 175, 55, 0.2);
}

.btn-outline {
    background: transparent;
    color: var(--color-gold-500);
    border: 1px solid var(--color-gold-500);
}

.btn-outline:hover {
    background: rgba(212, 175, 55, 0.1);
    transform: translateY(-2px);
}

/* 7. Category Badges & Tags */
.badge {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    padding: 0.25rem 0.75rem;
    border-radius: 50px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border: 1px solid currentColor;
}

.tag {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-text-secondary);
    background: var(--color-navy-800);
    padding: 0.2rem 0.6rem;
    border-radius: 4px;
}

/* 8. Animations */
.fade-up {
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 0.8s var(--ease-standard), transform 0.8s var(--ease-standard);
}

.fade-up.visible {
    opacity: 1;
    transform: translateY(0);
}

@keyframes pulse-gold {
    0% { box-shadow: 0 0 0 0 rgba(212, 175, 55, 0.4); }
    70% { box-shadow: 0 0 0 15px rgba(212, 175, 55, 0); }
    100% { box-shadow: 0 0 0 0 rgba(212, 175, 55, 0); }
}

/* 9. Responsive Overrides */
@media (max-width: 992px) {
    .nav-links { display: none; } /* Mobile Menu Toggle logic handled in main.js */
    .section { padding: 4rem 0; }
}

@media (max-width: 768px) {
    .container { padding: 0 1.5rem; }
    .section-title { font-size: 2rem; }
}

/* 10. Forms (Contact) */
.form-group {
    margin-bottom: 1.5rem;
}

.form-input {
    width: 100%;
    background: var(--color-navy-800);
    border: 1px solid var(--color-navy-600);
    border-radius: 6px;
    padding: 1rem;
    color: var(--color-white);
    font-family: var(--font-body);
    transition: border-color 0.3s ease;
}

.form-input:focus {
    outline: none;
    border-color: var(--color-gold-500);
}

textarea.form-input { min-height: 150px; resize: vertical; }
